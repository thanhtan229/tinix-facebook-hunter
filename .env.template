# ═══════════════════════════════════════════════════════════════
# Tinix Facebook Down — Environment Variables
# Copy this file to .env and fill in your values.
# ═══════════════════════════════════════════════════════════════

# Facebook App Credentials (required for Token Escalation)
# Get these from: https://developers.facebook.com/apps/
FB_APP_ID=your_facebook_app_id
FB_APP_SECRET=your_facebook_app_secret

# Shared App OAuth (used to get app-owned user tokens for all Facebook accounts)
# Add this exact URL to Valid OAuth Redirect URIs in your Facebook App settings.
FB_REDIRECT_URI=http://localhost:8787/facebook/callback

# Optional: override requested scopes for Facebook Login.
FB_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,pages_manage_metadata,pages_read_user_content,pages_manage_engagement,business_management,public_profile
